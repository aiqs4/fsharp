<Project>
  <!--
    CE-Enhancements Compatibility Test Harness
    ============================================
    This file is picked up by every project rooted under fsharp-mod-tests/.
    It redirects the F# compiler to the PATCHED build produced by the parent
    repository, guaranteeing that all external test suites run against our
    CE-Enhancements compiler, not the globally installed SDK compiler.

    The patched compiler is at:
      <repo-root>/artifacts/bin/fsc/Release/net10.0/fsc.dll

    In CI this path is set via the CE_FSC_DLL environment variable
    (see .github/workflows/ce-compat-tests.yml).  Locally, override with:
      msbuild /p:CEPatchedFscDll=/path/to/fsc.dll

    Properties explained:
      DisableAutoSetFscCompilerPath  – prevents the .NET SDK from substituting
                                       its own fsc path.
      DotnetFscCompilerPath          – the .dll passed as "dotnet <fsc.dll>" to
                                       the F# build task.
      FscToolPath / FscToolExe       – point to the dotnet host used to run the
                                       compiler dll (not the fsc binary itself).
      TreatWarningsAsErrors          – enabled to surface any new CE-related
                                       ambiguities introduced by the patch.
  -->

  <!-- ── Resolve patched compiler path ──────────────────────────────────── -->
  <PropertyGroup>
    <!-- Prefer env var set by CI, then MSBuild property override, then auto-detect -->
    <CEPatchedFscDll Condition="'$(CEPatchedFscDll)' == '' And '$(CE_FSC_DLL)' != ''">$(CE_FSC_DLL)</CEPatchedFscDll>
    <!-- Auto-detect: walk up from this file's directory until we find artifacts/ -->
    <_RepoRoot Condition="'$(CEPatchedFscDll)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)../'))</_RepoRoot>
    <CEPatchedFscDll Condition="'$(CEPatchedFscDll)' == '' And Exists('$(_RepoRoot)artifacts/bin/fsc/Release/net10.0/fsc.dll')">$([MSBuild]::NormalizePath('$(_RepoRoot)artifacts/bin/fsc/Release/net10.0/fsc.dll'))</CEPatchedFscDll>
    <!-- Debug configuration fallback -->
    <CEPatchedFscDll Condition="'$(CEPatchedFscDll)' == '' And Exists('$(_RepoRoot)artifacts/bin/fsc/Debug/net10.0/fsc.dll')">$([MSBuild]::NormalizePath('$(_RepoRoot)artifacts/bin/fsc/Debug/net10.0/fsc.dll'))</CEPatchedFscDll>
  </PropertyGroup>

  <!-- ── Lock compiler to patched build ────────────────────────────────── -->
  <PropertyGroup Condition="'$(CEPatchedFscDll)' != ''">
    <DisableAutoSetFscCompilerPath>true</DisableAutoSetFscCompilerPath>

    <!-- Run compiler as: dotnet <path-to-fsc.dll> -->
    <FscToolPath>$([System.IO.Path]::GetDirectoryName('$(DOTNET_HOST_PATH)'))</FscToolPath>
    <FscToolExe Condition="'$(OS)' != 'Windows_NT'">dotnet</FscToolExe>
    <FscToolExe Condition="'$(OS)' == 'Windows_NT'">dotnet.exe</FscToolExe>
    <DotnetFscCompilerPath>$(CEPatchedFscDll)</DotnetFscCompilerPath>
  </PropertyGroup>

  <!-- ── Warn when compiler could not be located ───────────────────────── -->
  <Target Name="CheckCEPatchedCompiler" BeforeTargets="CoreCompile" Condition="'$(CEPatchedFscDll)' == ''">
    <Warning Text="CE-Enhancements: patched fsc.dll not found. Set CEPatchedFscDll or CE_FSC_DLL, or build the parent repo first. The build may use the SDK compiler instead." />
  </Target>

  <!-- ── Compiler version guard ────────────────────────────────────────── -->
  <!-- Emits a build message confirming which compiler is in use. -->
  <Target Name="ReportCECompilerVersion" BeforeTargets="CoreCompile" Condition="'$(CEPatchedFscDll)' != ''">
    <Message Importance="High" Text="[CE-Compat] Using patched compiler: $(CEPatchedFscDll)" />
  </Target>

  <!-- ── Warnings-as-errors ─────────────────────────────────────────────── -->
  <!-- Enabled globally so that any new CE-related warning introduced by our
       patch is caught immediately. Individual libraries can opt out by setting
       TreatWarningsAsErrors=false in their own project file. -->
  <PropertyGroup>
    <CECompatTreatWarningsAsErrors Condition="'$(CECompatTreatWarningsAsErrors)' == ''">true</CECompatTreatWarningsAsErrors>
    <TreatWarningsAsErrors Condition="'$(CECompatTreatWarningsAsErrors)' == 'true'">true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
