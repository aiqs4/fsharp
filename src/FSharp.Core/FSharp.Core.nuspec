<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
    <metadata>
        $CommonMetadataElements$
        <language>en-US</language>
        <dependencies>
            <group targetFramework=".NET10.0" />
        </dependencies>
    </metadata>
    <files>
        $CommonFileElements$

        <file src="FSharp.Core\$Configuration$\net10.0\FSharp.Core.dll" target="lib\net10.0" />
        <file src="FSharp.Core\$Configuration$\net10.0\FSharp.Core.xml" target="lib\net10.0" />

        <!-- resources -->
        <file src="FSharp.Core\$Configuration$\net10.0\**\FSharp.Core.resources.dll" target="lib\net10.0" />
    </files>
</package>
